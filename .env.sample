# ─────────────────────────────────────────────────────────────
# Agent 365 Observability — identidade S2S (standard app)
# Copie este arquivo para `.env` e preencha o CLIENT_SECRET.
# O arquivo `.env` está no .gitignore — NUNCA faça commit de segredos.
# ─────────────────────────────────────────────────────────────

# Tenant do Entra (nicdux.com.br / Bitahon)
AGENT365_TENANT_ID=bff1a398-3f36-4452-b361-c6b58e4883fa

# App padrão (não-agentic) de telemetria: "my-adk-agent Observability".
# Este client ID também é usado como {agentId} na URL de exportação do Agent 365.
AGENT365_OBSERVABILITY_CLIENT_ID=ec773acb-119c-4cb0-b65f-8485321770fe

# Segredo do app de telemetria (gere com `az ad app credential reset`).
AGENT365_OBSERVABILITY_CLIENT_SECRET=

# ── Opcionais ────────────────────────────────────────────────
# Nome/namespace do serviço nas spans OTel.
OTEL_SERVICE_NAME=my-adk-agent
AGENT365_SERVICE_NAMESPACE=ai.agents
# Defina como "false" para desativar a observabilidade sem remover o código.
# AGENT365_OBSERVABILITY_ENABLED=true
